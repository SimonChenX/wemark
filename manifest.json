{
  "manifest_version": 3,
  "name": "WeMark",
  "version": "2.1.1",
  "description": "一键将微信公众号文章保存为 Markdown/HTML：自定义目录、独立文件夹、图片本地化、批量导入 / Save WeChat articles as Markdown",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_title": "将当前微信文章保存为 Markdown",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-as-markdown": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "使用已保存的设置，将当前微信文章保存为 Markdown"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://mp.weixin.qq.com/*",
        "https://mp.weixin.qq.com/*"
      ],
      "js": [
        "lib/turndown.js",
        "lib/turndown-plugin-gfm.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
